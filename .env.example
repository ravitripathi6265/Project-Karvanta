# ========================================================
# KARVANTA MARKETPLACE - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode
VITE_APP_ENV=development
VITE_APP_NAME="Karvanta"
VITE_APP_URL="http://127.0.0.1:5173"

# Database Configuration (Future PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/karvanta_db?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="your_production_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# SMS & WhatsApp OTP Gateway (e.g. Gupshup, MSG91, Twilio)
OTP_GATEWAY_PROVIDER="msg91"
OTP_AUTH_KEY="your_sms_gateway_auth_key_here"
OTP_SENDER_ID="KRVNTA"
OTP_EXPIRY_MINUTES=10

# Government Identity & Document Verification (e.g. DigiLocker, Karza, Surepass)
IDENTITY_VERIFICATION_API_KEY="your_id_verification_key_here"
GSTIN_LOOKUP_API_KEY="your_gstin_lookup_key_here"

# Secure Cloud Storage (S3 / Cloudflare R2 / GCS)
STORAGE_BUCKET_NAME="karvanta-media-bucket"
STORAGE_ACCESS_KEY_ID="your_storage_access_key"
STORAGE_SECRET_ACCESS_KEY="your_storage_secret_key"
STORAGE_REGION="ap-south-1"

# Logging & Monitoring
LOG_LEVEL="info"
SENTRY_DSN=""
